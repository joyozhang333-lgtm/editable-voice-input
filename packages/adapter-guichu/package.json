{
  "name": "@editable-voice-input/adapter-guichu",
  "version": "0.2.0-beta.1",
  "description": "GuiChu Here adapter for durable, exactly reconciled direct-audio turns.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --root ../.. packages/adapter-guichu/src"
  },
  "dependencies": { "@editable-voice-input/core": "workspace:*" },
  "publishConfig": { "access": "public" }
}
