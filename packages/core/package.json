{
  "name": "@editable-voice-input/core",
  "version": "0.1.0-alpha.1",
  "description": "Provider-neutral browser voice capture primitives and editable transcript state.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "publishConfig": {
    "access": "public"
  }
}
