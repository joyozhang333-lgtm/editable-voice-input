{
  "name": "@editable-voice-input/react",
  "version": "0.1.0-alpha.1",
  "description": "Accessible, editable, themeable React voice input with explicit submit semantics.",
  "license": "MIT",
  "engines": { "node": ">=20" },
  "type": "module",
  "sideEffects": ["src/styles.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./src/styles.css"
  },
  "files": ["dist", "src/styles.css", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --sourcemap --external react",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src"
  },
  "dependencies": {
    "@editable-voice-input/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.2.0"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "jsdom": "27.2.0",
    "react": "19.2.1",
    "react-dom": "19.2.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
